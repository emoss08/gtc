# Logging
LOG_LEVEL=INFO

# PostgreSQL Connection (required)
# Must include ?replication=database for logical replication
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_database?replication=database

# CDC Configuration
CDC_SLOT_NAME=cdc_demo_slot
CDC_PUBLICATION_NAME=cdc_demo_publication
CDC_STANDBY_TIMEOUT=10s
CDC_PARALLEL_SINKS=false
CDC_PROCESS_TIMEOUT=30s
# CDC_EXCLUDED_TABLES=public.schema_migrations,public.audit_logs

# Redis Sink (optional - enabled when REDIS_URL is set)
# REDIS_URL=redis://localhost:6379
# REDIS_STREAM_PREFIX=cdc
# REDIS_MAX_STREAM_LEN=10000

# Meilisearch Sink (optional - enabled when MEILISEARCH_URL is set)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=your_api_key
# MEILISEARCH_TABLE_MAPPING={"public.users":"users_index","public.products":"products_index"}
