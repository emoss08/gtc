# Logging
LOG_LEVEL=INFO

# HTTP Server
HTTP_PORT=8080

# PostgreSQL Connection (required)
# Must include ?replication=database for logical replication
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_database?replication=database

# CDC Configuration
CDC_SLOT_NAME=cdc_demo_slot
CDC_PUBLICATION_NAME=cdc_demo_publication
CDC_STANDBY_TIMEOUT=10s
CDC_PARALLEL_SINKS=false
CDC_PROCESS_TIMEOUT=30s
# CDC_EXCLUDED_TABLES=public.schema_migrations,public.audit_logs

# Resilience Configuration
CDC_CIRCUIT_BREAKER_THRESHOLD=5
CDC_CIRCUIT_BREAKER_TIMEOUT=30s
CDC_MAX_RETRIES=3
CDC_RETRY_BACKOFF_INITIAL=100ms
CDC_RETRY_BACKOFF_MAX=10s

# Sinks Configuration File (optional)
# Path to YAML file containing table-specific key patterns and mappings
# See config/sinks.example.yaml for format
# SINK_CONFIG_FILE=./config/sinks.yaml

# Redis Stream Sink (optional - enabled when REDIS_URL is set)
# REDIS_URL=redis://localhost:6379
# REDIS_STREAM_PREFIX=cdc
# REDIS_MAX_STREAM_LEN=10000

# Redis JSON Sink (optional - enabled when REDIS_JSON_URL is set)
# Stores latest record state, overwrites on INSERT/UPDATE, deletes on DELETE
# REDIS_JSON_URL=redis://localhost:6379
# REDIS_JSON_PREFIX=cdc

# Meilisearch Sink (optional - enabled when MEILISEARCH_URL is set)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=your_api_key
